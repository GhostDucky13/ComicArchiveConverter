<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: Right-click the ComicArchiveConverter project > Publish > choose "windows".
  Produces a folder containing ComicArchiveConverter.exe plus every DLL it needs,
  including the .NET runtime itself, so it runs on any Windows 10/11 PC without installing anything.

  It is a 32-bit (x86) build on purpose: the same files run on 32-bit Windows,
  64-bit Windows and Windows on ARM (Surface Pro X, Snapdragon laptops),
  so ONE download works on every Windows device that .NET 8 supports.
  build-release.ps1 also uses this profile to make a 64-bit (win-x64) build.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\publish\ComicArchiveConverter-windows\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
